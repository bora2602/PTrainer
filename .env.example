# Copy to .env to override defaults. Every value below has a working
# default in compose.yaml, so `docker compose up` runs without this file.

# Local database password. Change it before exposing the stack.
PTRAINER_DB_PASSWORD=ptrainer_local_dev

# App runtime. Set NODE_ENV=production before giving the address to anyone:
# it suspends the seeded demo accounts, whose passwords are in this repo, and
# it requires the METRICS_TOKEN and PRIVACY_* values further down.
NODE_ENV=development

# --- Hosting this machine as the server (on by default) ---
# With both of these empty, `docker compose up` starts an account-free quick
# tunnel and prints the address it was given. Cloudflare picks a new random
# hostname every start, so for a fixed address create a named tunnel in
# Zero Trust > Networks > Tunnels, route its public hostname to
# http://app:4173, then set both values below. The token is a secret.
TUNNEL_TOKEN=
TUNNEL_RUN_ARGS=

# Leave empty to use whatever address the tunnel reports. Set it to pin a
# fixed hostname; it must equal what people type in the browser, or every
# sign-in fails with ORIGIN_REJECTED while pages still load.
# APP_ORIGIN=https://ptrainer.your-domain.com

# Extra origins to accept alongside APP_ORIGIN, comma separated. Useful when
# the same server is reached by more than one hostname.
ALLOWED_ORIGINS=

# Take the client address from CF-Connecting-IP / X-Forwarded-For so each
# visitor gets their own rate-limit bucket instead of every visitor sharing
# one bucket. Only turn this on when the app port is not reachable directly,
# because a direct client could otherwise forge these headers.
TRUST_PROXY=true

# Caddy edge profile only: `docker compose --profile edge up`.
PTRAINER_DOMAIN=ptrainer.example.com

# Production only. Ptrainer refuses to start with NODE_ENV=production
# unless these are real values and APP_ORIGIN uses https://.
METRICS_TOKEN=replace_with_at_least_32_random_characters
PRIVACY_ORGANIZATION=Replace with registered business or operator legal name
PRIVACY_CONTACT_EMAIL=privacy@example.com
DATA_STORAGE_REGION=Canada
FOOD_API_USER_AGENT=Ptrainer/0.1 (https://github.com/bora2602/PTrainer)

# Only for running the app on the host with `node --env-file=.env server.mjs`.
# Compose builds its own DATABASE_URL from PTRAINER_DB_PASSWORD and ignores this.
# DATABASE_URL=postgresql://ptrainer:ptrainer_local_dev@127.0.0.1:54329/ptrainer
