{
  "name": "ptrainer",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.5.0",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "migrate": "node scripts/migrate.mjs",
    "test": "pnpm run test:unit && pnpm run test:static && pnpm run test:api && pnpm run test:e2e && pnpm run test:authz",
    "test:unit": "node --test validation.test.mjs",
    "test:api": "node ../work/security-smoke.mjs && node ../work/workout-logging-check.mjs && node ../work/phase2-check.mjs && node ../work/phase3-check.mjs && node ../work/phase4-check.mjs",
    "test:authz": "node ../work/endpoint-exposure-check.mjs && node ../work/cross-account-check.mjs",
    "test:static": "node ../work/accessibility-check.mjs && node ../work/contrast-check.mjs",
    "test:e2e": "node ../work/e2e-coaching-journey.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.3.14",
    "pg": "8.16.3"
  }
}
