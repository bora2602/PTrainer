#!/bin/sh
# Rebuild the PTrainer knowledge graph in the background after a branch switch.
#
# Hand-written on purpose; see the note in post-commit for why
# `graphify hook install` is not used.
#
# Unlike post-commit there is no cheap diff to filter on here - a branch switch
# can move arbitrarily much code - so this rebuilds unconditionally once it is
# satisfied that a real branch switch happened.

[ "${GRAPHIFY_SKIP_HOOK:-0}" = "1" ] && exit 0

PREV_HEAD=$1
NEW_HEAD=$2
BRANCH_SWITCH=$3

# Arg 3 is 1 for a branch switch, 0 for a file checkout (`git checkout -- foo`).
[ "$BRANCH_SWITCH" != "1" ] && exit 0

# `git checkout -b` with no start point reports a branch switch but leaves the
# tree identical - nothing to rebuild.
[ "$PREV_HEAD" = "$NEW_HEAD" ] && exit 0

# Only a first build is worth doing by hand.
[ -d "graphify-out" ] || exit 0

# A rebase or merge checks out trees repeatedly; rebuilding on each step would
# burn minutes and graph intermediate states that never existed as a commit.
GIT_DIR=${GIT_DIR:-$(git rev-parse --git-dir 2>/dev/null)}
[ -d "$GIT_DIR/rebase-merge" ] && exit 0
[ -d "$GIT_DIR/rebase-apply" ] && exit 0
[ -f "$GIT_DIR/MERGE_HEAD" ] && exit 0
[ -f "$GIT_DIR/CHERRY_PICK_HEAD" ] && exit 0

LOG="${TMPDIR:-/tmp}/ptrainer-graph-rebuild.log"

GRAPHIFY_MAX_WORKERS="${GRAPHIFY_MAX_WORKERS:-1}" \
  nohup node scripts/graph-build.mjs >"$LOG" 2>&1 &

echo "[graph] rebuilding in background (log: $LOG)"
exit 0
