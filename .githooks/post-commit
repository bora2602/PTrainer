#!/bin/sh
# Rebuild the PTrainer knowledge graph in the background after a commit.
#
# Hand-written on purpose; do NOT replace this with `graphify hook install`.
# The stock hook rebuilds by calling graphify's own incremental code path
# rooted at graphify-out/.graphify_root, which bypasses scripts/graph-build.mjs
# and therefore bypasses (a) the scope assertion that refuses a graph
# containing anything outside app/, work/ and scripts/, and (b) the staged
# build-then-swap that keeps a good graph in place when a rebuild goes bad.
# It also rebuilds on ANY changed file, so a CSS-only commit would pay for a
# full rebuild that cannot move the graph.
#
# The commit has already happened by the time this runs. Nothing here may fail
# it, so every path exits 0.

[ "${GRAPHIFY_SKIP_HOOK:-0}" = "1" ] && exit 0

# Only a first build is worth doing by hand.
[ -d "graphify-out" ] || exit 0

# Don't fight an in-progress rebase/merge/cherry-pick.
GIT_DIR=${GIT_DIR:-$(git rev-parse --git-dir 2>/dev/null)}
[ -d "$GIT_DIR/rebase-merge" ] && exit 0
[ -d "$GIT_DIR/rebase-apply" ] && exit 0
[ -f "$GIT_DIR/MERGE_HEAD" ] && exit 0
[ -f "$GIT_DIR/CHERRY_PICK_HEAD" ] && exit 0

# Rebuild only when this commit touched code in a graphed directory. A CSS,
# markdown or config commit cannot move the graph, and a 15s rebuild for
# nothing is how a hook earns itself a --no-verify.
CHANGED=$(git diff-tree --no-commit-id --name-only -r HEAD 2>/dev/null \
  | grep -E '^(app|work|scripts)/' \
  | grep -E '\.(mjs|js|sql|py)$')
[ -z "$CHANGED" ] && exit 0

LOG="${TMPDIR:-/tmp}/ptrainer-graph-rebuild.log"

# Detached and backgrounded so `git commit` returns immediately.
# Sequential extraction: Git for Windows hooks inherit fragile pipe handles
# from GUI clients and agent shells, which parallel workers trip over.
GRAPHIFY_MAX_WORKERS="${GRAPHIFY_MAX_WORKERS:-1}" \
  nohup node scripts/graph-build.mjs >"$LOG" 2>&1 &

echo "[graph] rebuilding in background (log: $LOG)"
exit 0
